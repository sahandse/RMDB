{
  "openapi": "3.0.3",
  "info": {
    "title": "RMDB Public Data API",
    "version": "1.0.0",
    "description": "Read-only static CC0 Wikidata snapshots. Not a dynamic API; no server-side filtering or keys. TVmaze records excluded.",
    "license": {
      "name": "CC0-1.0",
      "url": "https://creativecommons.org/publicdomain/zero/1.0/"
    }
  },
  "servers": [
    {
      "url": "https://sahandse.github.io/RMDB/api/v1"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "summary": "API index",
        "responses": {
          "200": {
            "description": "API metadata"
          }
        }
      }
    },
    "/movies.json": {
      "get": {
        "summary": "CC0 movies",
        "responses": {
          "200": {
            "description": "Snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          }
        }
      }
    },
    "/people.json": {
      "get": {
        "summary": "CC0 people",
        "responses": {
          "200": {
            "description": "Snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Snapshot": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "license": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
